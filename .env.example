# Client-visible Supabase settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_API_URL=http://localhost:8000

# Client-visible Ola Maps key. Restrict it to your production domain.
VITE_OLA_MAPS_API_KEY=your-ola-maps-browser-key

# Never place SUPABASE_SERVICE_ROLE_KEY in this frontend file.
# Server-only values belong in backend/.env.
