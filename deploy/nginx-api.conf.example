# Place inside nginx's http context. Terminate HTTPS with your hosting provider
# or add your own certificate directives before exposing this listener publicly.
# Only the trusted reverse proxy should be able to reach API port 8000.
limit_req_zone $binary_remote_addr zone=feedforward_api:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=feedforward_connections:10m;
server {
    listen 127.0.0.1:8080;
    server_name _;
    client_max_body_size 1m;
    client_body_timeout 15s;
    location / {
        limit_req zone=feedforward_api burst=30 nodelay;
        limit_req_status 429;
        limit_conn feedforward_connections 20;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
